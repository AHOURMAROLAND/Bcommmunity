# Copy to /opt/bakhita/.env on the server. Never commit the real .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET
ALLOWED_HOSTS=community.example.org
ADMIN_URL=gestion-bakhita-x7/
CORS_ALLOWED_ORIGINS=https://community.example.org
CSRF_TRUSTED_ORIGINS=https://community.example.org
SITE_URL=https://community.example.org
FRONTEND_URL=https://community.example.org
SECURE_SSL_REDIRECT=1

DOMAIN=community.example.org
ACME_EMAIL=admin@example.org
GHCR_OWNER=your-github-owner-lowercase
TAG=latest

# Use the pooled URL for app connections. Keep DIRECT_DATABASE_URL for migrations/backups.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=

GOOGLE_CLIENT_IDS=
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=Bakhita Community <no-reply@example.org>
ADMIN_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=
FCM_SERVICE_ACCOUNT_JSON=

SENTRY_DSN=
ENVIRONNEMENT=production
VERSION=production
REDIS_MAX_MEMORY=256mb

# Réseaux internes de confiance (Caddy -> API). Sans cette ligne, le journal d'activité
# de l'admin enregistre l'adresse interne de Caddy au lieu de celle du visiteur.
TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
