DJANGO_SECRET_KEY=generer-une-longue-valeur-aleatoire
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=gestion-bakhita-x7/
CORS_ALLOWED_ORIGINS=https://bakhita.example,https://localhost,capacitor://localhost
SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Base de donnees
# Dev : laisser vide (SQLite automatique)
# Production Neon : utiliser l'URL poolee pour l'app, l'URL directe pour les migrations
DATABASE_URL=postgresql://USER:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/bakhita?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/bakhita?sslmode=require

# Redis (Channels + cache)
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (laisser vide en dev = stockage disque local)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bakhita-media
R2_PUBLIC_DOMAIN=cdn.bakhita.example

# Google OAuth (identifiants client Google acceptes : web et Firebase pour Android)
GOOGLE_CLIENT_IDS=ID_WEB.apps.googleusercontent.com,ID_FIREBASE.apps.googleusercontent.com

# Email
ADMIN_EMAIL=
SEUIL_MASQUAGE_AUTO=3
EMAIL_HOST=smtp.exemple.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Bakhita Community <no-reply@bakhita.example>

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_EAGER=0
RESUME_HEURE_UTC=17

# Push notifications (VAPID - generer avec : npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=contact@votre-ecole.example

# FCM Android (fichier JSON du compte de service Firebase)
FCM_SERVICE_ACCOUNT_JSON=
