DJANGO_SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,api,web
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
SECURE_SSL_REDIRECT=0
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
ADMIN_URL=gestion-bakhita-x7/
SITE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Base de donnees
# Utilise par Docker Compose ; genere une valeur aleatoire alphanumerique.
DB_PASSWORD=remplacer-par-une-valeur-aleatoire
# Laisser vide pour utiliser SQLite hors Docker.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Redis (Channels + cache)
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (laisser vide pour utiliser le stockage disque local)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=

# Google OAuth (identifiants client Google acceptes : web et Firebase pour Android)
GOOGLE_CLIENT_IDS=ID_WEB.apps.googleusercontent.com,ID_FIREBASE.apps.googleusercontent.com
# Identifiant client OAuth Web public, configure dans Google Cloud Console
VITE_GOOGLE_CLIENT_ID=ID_WEB.apps.googleusercontent.com

# Email
ADMIN_EMAIL=
SEUIL_MASQUAGE_AUTO=3
EMAIL_HOST=smtp.exemple.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Bakhita Community <no-reply@bakhita.example>

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_EAGER=0
RESUME_HEURE_UTC=17

# Push notifications (VAPID - generer avec : npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=contact@votre-ecole.example

# FCM Android (fichier JSON du compte de service Firebase)
FCM_SERVICE_ACCOUNT_JSON=
